# Port the server listens on
PORT=3001

# Set to production for deployment
NODE_ENV=production

# Password to log in to the app
AUTH_PASSWORD=choose_a_strong_password

# Your Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (config/ai.js): interactive agent / background jobs
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BACKGROUND_MODEL=claude-haiku-5-5
# Server-side fallback model on refusals (Sonnet only); set to off to disable
# AI_FALLBACKS=on
# Local development/tests: deterministic mock model, no API calls
# AI_MOCK=1

# Session transcription (ElevenLabs Scribe). Without a key, recordings are saved
# but not transcribed; existing recordings are transcribed once a key is added.
# ELEVENLABS_API_KEY=your_elevenlabs_key
# ELEVENLABS_STT_MODEL=scribe_v2
# TRANSCRIPTION_LANGUAGE=he

# Recordings are stored next to DB_PATH by default (keep both on the Railway volume)
# RECORDINGS_DIR=/data/recordings

# Knowledge base file imported at startup when newer (production: scripts/upload-knowledge-base.js)
# KNOWLEDGE_BASE_PATH=./data/dietitian-knowledge-base.json

# Google Calendar appointment-scheduling links (meetings page + WhatsApp {{booking_link}})
# Legacy CALENDLY_FIRST_LINK / CALENDLY_FOLLOWUP_LINK are still read as a fallback.
BOOKING_LINK_FIRST=https://calendar.app.google/your-first-meeting-link
BOOKING_LINK_FOLLOWUP=https://calendar.app.google/your-follow-up-link

# Google Calendar OAuth2 (from Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://web-production-790f4.up.railway.app/api/google/callback

# ── Admin WhatsApp channel (Kapso) — the only automated WhatsApp integration ──
# Webhook: POST /api/integrations/whatsapp/webhook (event whatsapp.message.received)
# Client messages are never automated: they go out manually via wa.me links.
KAPSO_API_KEY=your_kapso_api_key
KAPSO_PHONE_NUMBER_ID=your_kapso_phone_number_id
KAPSO_WEBHOOK_SECRET=your_kapso_webhook_secret
ADMIN_WHATSAPP_PHONE=05XXXXXXXX
# KAPSO_BRIEF_TEMPLATE=ops_brief
# KAPSO_TEMPLATE_LANG=he
