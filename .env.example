# Port the server listens on
PORT=3001

# Set to production for deployment
NODE_ENV=production

# Password to log in to the app
AUTH_PASSWORD=choose_a_strong_password

# Your Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# deeplink = manual WhatsApp, api = WhatsApp Business API
WHATSAPP_MODE=deeplink

# Google Calendar appointment-scheduling links (meetings page + WhatsApp {{booking_link}})
# Legacy CALENDLY_FIRST_LINK / CALENDLY_FOLLOWUP_LINK are still read as a fallback.
BOOKING_LINK_FIRST=https://calendar.app.google/your-first-meeting-link
BOOKING_LINK_FOLLOWUP=https://calendar.app.google/your-follow-up-link

# Google Calendar OAuth2 (from Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://web-production-790f4.up.railway.app/api/google/callback

# Natanel's personal WhatsApp number (for bot drafts and forwards)
NATANEL_PHONE=972XXXXXXXXX

# WhatsApp Cloud API (Meta Business → WhatsApp → API Setup)
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# ── WhatsApp webhook signature verification (enforced only when set) ──
# Meta App Dashboard → App Settings → Basic → App Secret
WHATSAPP_APP_SECRET=your_meta_app_secret
